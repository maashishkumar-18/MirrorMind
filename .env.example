# ── Local LLM (Ollama) ───────────────────────────────────────────────────
# The Personal AI Companion runs entirely local. The Ollama daemon is a
# bundled sidecar; no API keys. OLLAMA_DEFAULT_MODEL is the model
# simple_generate() uses when a caller doesn't name one.
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# ── Local data & model paths ─────────────────────────────────────────────
# RAGPIPE_DB_PATH: the session SQLite database. SQLCipher-encrypted at rest
#   (Phase 2 Step 2.1). The 32-byte encryption key is NOT an env var — it is
#   generated on first launch and stored in the Windows Credential Manager
#   (service "PersonalAICompanion"). A missing key after a Windows reinstall
#   is unrecoverable by design; export your data regularly.
# RAGPIPE_EMBEDDING_MODEL_PATH: override for the bundled
#   all-MiniLM-L6-v2 directory (default: rag-pipeline/models/all-MiniLM-L6-v2).
# RAGPIPE_DATA_DIR: mutable app state written by the backend at runtime
#   (default: ./data). Currently holds app_config.json — the active
#   generative model (Phase 1 Step 1.6). In production this is a per-user
#   app-data directory. Not committed (see .gitignore).
# RAGPIPE_DB_PATH=./db/session.db
# RAGPIPE_EMBEDDING_MODEL_PATH=./models/all-MiniLM-L6-v2
# RAGPIPE_DATA_DIR=./data

# ── App ───────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Observability (Langfuse Cloud) ───────────────────────────────────────
# Optional — observability/tracing.py is a no-op if these are unset, so the
# pipeline runs identically without them. Create a free project at
# https://cloud.langfuse.com, then Settings → API Keys for these three.
# LANGFUSE_HOST is region-specific: https://cloud.langfuse.com (EU, default)
# or https://us.cloud.langfuse.com (US).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Optional per-component overrides ─────────────────────────────────────
# Every retrieval/generation/ingestion/features config file can be overridden
# via env var instead of editing YAML. See the RAGPIPE_* mappings in
# src/retrieval/{hybrid_search,reranker,confidence,context_builder,router}.py,
# src/generation/{config,prompt_builder}.py, src/ingestion/chunker.py,
# src/features/{summary_handler,scheduler,backup_manager}.py, and
# src/models/{app_config,catalog}.py.
# Examples (all optional):
# RAGPIPE_SEMANTIC_K=40
# RAGPIPE_RERANKER_BACKEND=cross_encoder
# RAGPIPE_CONFIDENCE_HIGH=0.75
# RAGPIPE_ROUTER_TOP_K=5
# RAGPIPE_CHUNK_WINDOW_SIZE=10
# RAGPIPE_CHUNK_STRIDE=5
# RAGPIPE_SUBCHUNK_THRESHOLD=20
# RAGPIPE_SUMMARY_CONFIG=./config/features/summary.yaml
# RAGPIPE_SUMMARY_DAILY_TIME=21:00
# RAGPIPE_SCHEDULER_CONFIG=./config/features/scheduler.yaml
# RAGPIPE_SCHEDULER_POLL_SECONDS=60
# Automatic local backups (Phase 2 Step 2.2) — snapshots under
# <RAGPIPE_DATA_DIR>/backups/, rolling retention, SQLCipher-encrypted.
# RAGPIPE_BACKUP_CONFIG=./config/features/backup.yaml
# RAGPIPE_BACKUP_DAILY_TIME=02:00
# RAGPIPE_BACKUP_RETENTION=7
# RAGPIPE_APP_CONFIG_PATH=./data/app_config.json
# RAGPIPE_MODEL_CATALOG=./config/models/catalog.json
