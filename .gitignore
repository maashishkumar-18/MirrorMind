# Eval run outputs — regenerated each run, uploaded as CI artifacts instead
# of being committed (see .github/workflows/ci.yml)
eval/results/

# Observability metrics store — local SQLite db (+ WAL/SHM sidecar files),
# regenerated by eval/run_eval.py and scripts/simulate_traffic.py.
observability/metrics.db
observability/metrics.db-wal
observability/metrics.db-shm

# Session DB (Phase 0 Step 0.4+) — local SQLite db, WAL/SHM sidecars, and
# migration-runner pre-migration snapshots. Never committed; created by
# db/connection.py and db/migration_runner.py at runtime/test time.
db/*.db
db/*.db-wal
db/*.db-shm
db/**/*.bak

# ipc/ (Phase 0 Step 0.1.5) — Node/TypeScript shared schema package
ipc/node_modules/
ipc/dist/

# Local tooling state, not project source
.claude/
